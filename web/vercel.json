{
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/home", "permanent": true },
    { "source": "/index.html", "destination": "/home", "permanent": true }
  ],
  "rewrites": [
    { "source": "/login", "destination": "https://stocklink-demo-admin.vercel.app/" },
    { "source": "/login/:path*", "destination": "https://stocklink-demo-admin.vercel.app/:path*" }
  ]
}
